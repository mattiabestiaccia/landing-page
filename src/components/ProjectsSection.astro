---
import ProjectCard from './ProjectCard.astro';

interface Project {
  title: string;
  description: string;
  image?: string;
  tags: string[];
  githubUrl?: string;
  demoUrl?: string;
  slug?: string;
}

interface Props {
  projects?: Project[];
}

const defaultProjects: Project[] = [
  {
    title: "Barbershop Booking Site",
    description: "Sito web vetrina con sistema di prenotazione online per barbiere. Slot calcolati in tempo reale da Google Calendar, conferme email, pannello admin protetto.",
    image: "/images/projects/barbershop.png",
    tags: ["Next.js 15", "TypeScript", "Tailwind CSS", "Google Calendar API", "Resend", "TDD"],
    githubUrl: "https://github.com/mattiabestiaccia/barbershop-booking-site",
    demoUrl: "https://landing-page-parrucchiere.vercel.app"
  },
  {
    title: "Automatismi",
    description: "Piattaforma B2B SaaS multi-tenant per automatizzare la comunicazione dei negozi italiani tramite telefono (IVR) e WhatsApp chatbot con AI.",
    tags: ["TypeScript", "Supabase", "Vonage", "WhatsApp API", "Gemini AI", "Vercel"],
    githubUrl: "https://github.com/mattiabestiaccia/automatismi"
  },
  {
    title: "WST Vegetation Classification",
    description: "Random Forest classification for land cover analysis using Wavelet Scattering Transform, RGB statistics, and hybrid feature extraction from aerial imagery.",
    image: "/images/projects/wst-classification.png",
    tags: ["Python", "scikit-learn", "Random Forest", "WST", "Remote Sensing", "ML"],
    githubUrl: "https://github.com/mattiabestiaccia/WST-Feature-Extraction-for-Remote-Sensing-Vegetation-Classification-via-Machine-Learning"
  },
  {
    title: "Gmail Auto-Triage",
    description: "CLI tool that fetches unread Gmail emails, classifies them with Gemini Flash, and applies AutoTriage labels automatically. Runs unattended via cron.",
    tags: ["Python", "Gemini Flash", "Gmail API", "LLM", "uv", "pytest"],
    githubUrl: "https://github.com/mattiabestiaccia/gmail-auto-triage"
  },
  {
    title: "Brain Suite",
    description: "Structured brainstorming framework for Claude Code. Explore product ideas dimension by dimension with Socratic dialogue, persistent artifacts, and GSD-ready handoff.",
    tags: ["Claude Code", "Bash", "AI Agents", "Developer Tools", "CLI"],
    githubUrl: "https://github.com/mattiabestiaccia/brain-suite"
  },
  {
    title: "Restaurant Phone Bot",
    description: "Sistema IVR bilingue (IT/EN) multi-tenant per la gestione automatizzata delle chiamate ai ristoranti. Una singola codebase serve tutti i clienti tramite configurazione JSON.",
    tags: ["Node.js", "Twilio", "Supabase", "Vercel", "JavaScript", "Jest"],
    githubUrl: "https://github.com/mattiabestiaccia/restaurant-phone-bot"
  },
  {
    title: "Social Content Automation",
    description: "Pipeline AI serverless che recupera notizie da arXiv e HuggingFace, seleziona il miglior articolo con LLM, genera un post LinkedIn divulgativo in italiano e lo pubblica previo approvazione via email.",
    tags: ["Next.js", "TypeScript", "Gemini AI", "LinkedIn API", "Resend", "GitHub Actions"],
    githubUrl: "https://github.com/mattiabestiaccia/social-content-automation"
  },
  {
    title: "Magazzino Sanitario",
    description: "App desktop cross-platform per la gestione di magazzino sanitario. Tracciamento scadenze, scorte minime, trasferimenti tra inventari. Offline-first con SQLite embedded.",
    tags: ["Tauri 2", "React", "TypeScript", "SQLite", "Zustand", "Rust", "Vitest"],
    githubUrl: "https://github.com/mattiabestiaccia/magazzino-sanitario"
  }
];

const { projects = defaultProjects } = Astro.props;
---

<section id="projects" class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-surface-900 dark:text-surface-100 mb-4">
        Featured Projects
      </h2>
      <p class="text-lg text-surface-600 dark:text-surface-400 max-w-2xl mx-auto">
        A selection of AI/ML projects I've worked on, from research to production.
      </p>
    </div>

    <!-- Projects grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>

  </div>
</section>
