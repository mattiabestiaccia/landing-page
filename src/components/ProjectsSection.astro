---
import ProjectCard from './ProjectCard.astro';

interface Project {
  title: string;
  description: string;
  image?: string;
  tags: string[];
  githubUrl?: string;
  demoUrl?: string;
  slug?: string;
}

interface Props {
  projects?: Project[];
}

const defaultProjects: Project[] = [
  {
    title: "Barbershop Booking Site",
    description: "Sito web vetrina con sistema di prenotazione online per barbiere. Slot calcolati in tempo reale da Google Calendar, conferme email, pannello admin protetto.",
    image: "/images/projects/barbershop.png",
    tags: ["Next.js 15", "TypeScript", "Tailwind CSS", "Google Calendar API", "Resend", "TDD"],
    githubUrl: "https://github.com/mattiabestiaccia/barbershop-booking-site",
    demoUrl: "https://landing-page-parrucchiere.vercel.app"
  },
  {
    title: "Automatismi",
    description: "Piattaforma B2B SaaS multi-tenant per automatizzare la comunicazione dei negozi italiani tramite telefono (IVR) e WhatsApp chatbot con AI.",
    tags: ["TypeScript", "Supabase", "Vonage", "WhatsApp API", "Gemini AI", "Vercel"],
    githubUrl: "https://github.com/mattiabestiaccia/automatismi"
  },
  {
    title: "WST Vegetation Classification",
    description: "Random Forest classification for land cover analysis using Wavelet Scattering Transform, RGB statistics, and hybrid feature extraction from aerial imagery.",
    image: "/images/projects/wst-classification.png",
    tags: ["Python", "scikit-learn", "Random Forest", "WST", "Remote Sensing", "ML"],
    githubUrl: "https://github.com/mattiabestiaccia/WST-Feature-Extraction-for-Remote-Sensing-Vegetation-Classification-via-Machine-Learning"
  }
];

const { projects = defaultProjects } = Astro.props;
---

<section id="projects" class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-surface-900 dark:text-surface-100 mb-4">
        Featured Projects
      </h2>
      <p class="text-lg text-surface-600 dark:text-surface-400 max-w-2xl mx-auto">
        A selection of AI/ML projects I've worked on, from research to production.
      </p>
    </div>

    <!-- Projects grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>

  </div>
</section>
